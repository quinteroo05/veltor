{% comment %} snippets/product-card.liquid {% endcomment %}
<div class="product-card">
  <div class="img-wrapper">
    {% if product.type != blank %}
      <span class="badge">{{ product.type }}</span>
    {% endif %}
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy">
    {% else %}
      {{ 'product-1' | placeholder_svg_tag }}
    {% endif %}
  </div>

  <div class="product-info">
    <h3 class="product-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="product-price">{{ product.price | money }}</div>
    <div class="product-rating">★ 5.0 (1.2k Reviews)</div>
  </div>

  <div class="product-actions">
    {% form 'product', product %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" name="add" class="btn-card btn-cart">Add to Cart</button>
    {% endform %}
    
    <a href="/checkout" class="btn-card btn-buy">Buy Now</a>
  </div>
</div>
